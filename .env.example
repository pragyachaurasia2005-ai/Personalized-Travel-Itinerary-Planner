# TravelCraft AI Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000

# 1. Google Gemini API Integration (Optional)
# Get your free key at: https://aistudio.google.com/
# When left empty, the application uses the built-in Adaptive Local Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase Cloud Database Integration (Optional)
# Create a free project at: https://supabase.com/
# Run the SQL schema in backend/supabase_schema.sql via Supabase SQL Editor.
# When left empty, the application uses persistent local SQLite storage (travel_planner.db).
SUPABASE_URL=
SUPABASE_KEY=
